      { FDigimonCampaignDialogueVariant V;
        V.Branches = {}; V.RequiresCompleted = {TEXT("ghost_14_quest")}; V.RequiresHacked = {};
        V.RequiresReveal = -1; V.RequiresComplete = -1;
        V.Text = TEXT("Venn's trace preserved the order: victory receipt, recovery channel, then intrusion. Noor thinks the address changes form a route. Use Mina's isolated array to test that. If the Regent is building something from our results, we need to see its shape."); N.DialogueVariants.Add(V); }
      { FDigimonCampaignDialogueVariant V;
        V.Branches = {}; V.RequiresCompleted = {TEXT("ghost_12_quest")}; V.RequiresHacked = {};
        V.RequiresReveal = -1; V.RequiresComplete = -1;
