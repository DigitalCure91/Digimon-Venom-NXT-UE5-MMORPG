        V.Branches = {}; V.RequiresCompleted = {TEXT("ghost_24_quest")}; V.RequiresHacked = {};
        V.RequiresReveal = -1; V.RequiresComplete = -1;
        V.Text = TEXT("Jun's clean recorder passed: her account stayed hers after the victory. The old workflow sent a request nobody chose. Noor can prepare an independent live-key challenge at the certificate antechamber next. That test should tell us who controls the signing key now, rather than who once owned a copy."); N.DialogueVariants.Add(V); }
      { FDigimonCampaignDialogueVariant V;
        V.Branches = {}; V.RequiresCompleted = {TEXT("ghost_23_quest")}; V.RequiresHacked = {};
        V.RequiresReveal = -1; V.RequiresComplete = -1;
        V.Text = TEXT("Iona has retired the recorder after finding the complete instruction. I know what that looks like. Finish the clean-room test before you decide what it proves. A tool can be misused; the question is who kept choosing to use it that way."); N.DialogueVariants.Add(V); }
      { FDigimonCampaignDialogueVariant V;
        V.Branches = {}; V.RequiresCompleted = {TEXT("ghost_21_quest")}; V.RequiresHacked = {};
        V.RequiresReveal = -1; V.RequiresComplete = -1;
        V.Text = TEXT("The registry holds every witness we met and people harmed before this case began. Keep their names private. Bea's refusal control is the next step; if the witnesses can close their own connections, the Regent loses more than a route. He loses the claim that nobody can leave."); N.DialogueVariants.Add(V); }
      { FDigimonCampaignDialogueVariant V;
        V.Branches = {}; V.RequiresCompleted = {TEXT("ghost_20_quest")}; V.RequiresHacked = {};
        V.RequiresReveal = -1; V.RequiresComplete = -1;
        V.Text = TEXT("Rill's queued threat was written before the attack it describes. That is evidence of a staged pursuit. Keep Ada's original copy. The next address is a registry, and I suspect its list will show why the Regent wanted so many different witnesses in our path."); N.DialogueVariants.Add(V); }
      { FDigimonCampaignDialogueVariant V;
        V.Branches = {}; V.RequiresCompleted = {TEXT("ghost_19_quest")}; V.RequiresHacked = {};
        V.RequiresReveal = -1; V.RequiresComplete = -1;
        V.Text = TEXT("The independent audit tied REGENT to my old relief key and a recent renewal. I understand why that troubles Iona. Keep the raw record. A copied key could make the same mark; what you still need is proof of who controls the live one."); N.DialogueVariants.Add(V); }
      { FDigimonCampaignDialogueVariant V;
